<?xml version="1.0" encoding="utf-8"?>
<!-- Code generated by gofastr-native. DO NOT EDIT. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="{{xml .ID}}"
    android:versionCode="{{.VersionCode}}"
    android:versionName="{{xml .Version}}">

    <uses-sdk android:minSdkVersion="{{.MinSDK}}" android:targetSdkVersion="{{.TargetSDK}}" />

    <!-- The app never leaves the device. Kept for the prototype because
         WebView loads have been reported to fail without it even when
         every request is intercepted; VERIFY ON DEVICE whether it can go. -->
    <uses-permission android:name="android.permission.INTERNET" />
{{if ne .Renderer "native"}}{{range .AndroidWebViewPermissions}}    <uses-permission android:name="{{xml .}}" />
{{end}}{{end}}{{if eq .Renderer "native"}}
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
{{if .MicrophoneUsage}}    <uses-permission android:name="android.permission.RECORD_AUDIO" />{{end}}
{{if and .SecureStorage .BiometricUsage}}    <uses-permission android:name="android.permission.USE_BIOMETRIC" />{{end}}
{{range .AndroidExtensionPermissions}}    <uses-permission android:name="{{xml .}}" />
{{end}}{{end}}

    <application
        android:label="{{xml .Name}}"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:enableOnBackInvokedCallback="{{if eq .Renderer "native"}}true{{else}}false{{end}}"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
{{if .URLScheme}}
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="{{xml .URLScheme}}" />
            </intent-filter>
{{end}}
{{if .ReceiveShares}}
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
{{end}}
        </activity>
{{if .BackgroundTasks}}
        <service android:name=".BackgroundService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
{{end}}
{{if .Widgets}}
        <meta-data android:name="dev.gofastr.nativeui.widgetScheme" android:value="{{xml .URLScheme}}" />
        <receiver android:name="dev.gofastr.nativeui.HomeWidget" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/gofastr_widget" />
        </receiver>
{{end}}
{{if eq .Renderer "native"}}
        <provider android:name="dev.gofastr.nativeui.TransferProvider"
            android:authorities="{{xml .ID}}.transfers" android:exported="false" android:grantUriPermissions="true" />
        <receiver android:name="dev.gofastr.nativeui.ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
{{range .AndroidExtensionServices}}        <service android:name="dev.gofastr.nativeui.{{xml .Class}}" android:exported="false"{{if .ForegroundServiceType}} android:foregroundServiceType="{{xml .ForegroundServiceType}}"{{end}} />
{{end}}{{end}}
    </application>
</manifest>
